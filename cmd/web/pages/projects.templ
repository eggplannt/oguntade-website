templ Projects() {
	<div class="px-10 lg:px-20 pt-10 pb-24">
		<h1 class="text-4xl font-bold">Projects</h1>
		@releaseBlock(csus, true)
		for _, r := range releases {
			@releaseBlock(r, false)
		}
		<p class="mt-12 text-muted-foreground">
			Older builds on <a class="text-yellow-700 dark:text-primary underline underline-offset-4 hover:no-underline" href="https://github.com/eggplannt" target="_blank">GitHub</a>
		</p>
	</div>
}

templ releaseBlock(r release, upcoming bool) {
	<section class="mt-14">
		<div class="flex flex-col items-start gap-3">
			<span class="text-3xl font-bold">
				if upcoming {
					<span class="text-yellow-700 dark:text-primary"><span class="underline decoration-2 underline-offset-8">{ r.Version }</span></span>
				} else {
					<span class="rounded bg-primary px-3 py-1 text-primary-foreground">{ r.Version }</span>
				}
			</span>
			if r.Title != "" {
				<span class="text-3xl font-bold">{ r.Title }</span>
			}
		</div>
		if r.Summary != "" {
			<p class="mt-4 max-w-4xl text-lg text-muted-foreground">{ r.Summary }</p>
		}
		<div class="mt-6 grid gap-8 lg:grid-cols-2">
			for _, p := range r.Projects {
				@entry(p)
			}
		</div>
	</section>
}

templ entry(p projectInfo) {
	<article class="flex flex-col rounded-lg bg-accent p-6 md:p-8">
		<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
			<h3 class="text-2xl md:text-3xl font-bold break-words">{ p.Name }</h3>
			<div class="flex items-center gap-4">
				<span class="text-sm text-muted-foreground">{ p.Kind }</span>
				if p.Source != "" {
					<a class="text-muted-foreground hover:text-foreground" href={ templ.SafeURL(p.Source) } target="_blank" aria-label="Source on GitHub" title="Source on GitHub">
						@icon.Github(icon.Props{Size: 24})
					</a>
				}
			</div>
		</div>
		<p class="mt-2 text-lg text-muted-foreground">
			@rich(p.Intro)
		</p>
		<ul class="mt-5 grow list-disc space-y-2 pl-5 marker:text-yellow-700 dark:marker:text-primary">
			for _, note := range p.Notes {
				<li>
					@rich(note)
				</li>
			}
		</ul>
		<ul class="mt-6 flex flex-wrap gap-2 text-sm">
			for _, tool := range p.Tools {
				<li class="rounded border border-foreground/15 px-2 py-1 text-foreground/80">{ tool }</li>
			}
		</ul>
		if len(p.Links) > 0 {
			<div class="mt-5 flex flex-wrap gap-4 border-t border-border pt-4">
				for _, l := range p.Links {
					<a class="text-yellow-700 dark:text-primary underline underline-offset-4 hover:no-underline" href={ templ.SafeURL(l.Href) } target="_blank">{ l.Label }</a>
				}
			</div>
		}
	</article>
}

// rich renders text with **double-asterisk** segments in bold.
templ rich(text string) {
	for i, part := range strings.Split(text, "**") {
		if i%2 == 1 {
			<strong class="font-bold text-foreground">{ part }</strong>
		} else {
			{ part }
		}
	}
}
